{
  "//": "仅用于 `tsc --noEmit` 类型自检。ui/ 目录没有 node_modules，react 类型通过 paths 指向 web/node_modules/@types。构建时组件会被复制进 web/src，届时由 web/tsconfig.json 接管，本文件不参与任何构建。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../web/node_modules/@types/react"],
      "react/*": ["../../web/node_modules/@types/react/*"],
      "react-dom": ["../../web/node_modules/@types/react-dom"],
      "react-dom/*": ["../../web/node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "types.ts",
    "stepping.ts",
    "derive.ts",
    "highlight.ts",
    "VisualEngine.tsx",
    "CodePane.tsx",
    "DebugToolbar.tsx",
    "ArrayView.tsx",
    "FrameStackView.tsx",
    "GeneralView.tsx",
    "index.ts"
  ]
}
