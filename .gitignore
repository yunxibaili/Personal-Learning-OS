# 用户私有数据——永不入库
workspace/

# 本地归档区：旧代码快照/旧文档版本/临时脚本——仅存本机，永不入库
_local/

# 一次性实验沙盒（用完即删）与后端缓存产物——永不入库
sandbox/
server/.cache/

# 密钥与环境
.env
.env.*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/
# 构建验证产物（vite build --outDir dist*）——两种连字符写法都忽略
dist-verify/
dist_verify*/
dist-verify*/

# 构建与测试产物
coverage/
*.log

# 打包产物（M6 起）
src-tauri/target/

# OS
.DS_Store
Thumbs.db
